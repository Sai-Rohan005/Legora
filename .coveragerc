[run]
branch = True
source =
    db.parsers
    retrieval.hybrid_retrieval
    retrieval.cross_encoder
    LegalRag.rag_pipeline
    LegalRag.citation_check
    eval.run_answer_eval
    eval.judge_validation
    eval.profile_pipeline
    legora.performance
    scripts.ingest
    scripts.corpus_stats
# The requested parser scope excludes ingestion clients and runnable examples.
omit =
    */usage.py
    db/ingest.py
    db/parsers/*/ingest.py
    */search.py
    */qdrant_store.py
    */embedder.py
    */embeddings_test.py

[report]
show_missing = True
exclude_also =
    if __name__ == .__main__.:

# Copy to .env and replace the placeholders. Never commit real credentials.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
QDRANT_URL=http://localhost:6333
# Optional for an unauthenticated local instance.
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=replace-with-neo4j-username
NEO4J_PASSWORD=replace-with-neo4j-password
KANOON_TOKEN=replace-with-kanoon-token
TOP_K=30
RERANK_K=5
JUDGMENT_K=5
PASS_THRESHOLD=80
MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# Streamlit connects to this API; the UI requires only these two settings.
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=180
# Per-call backend SDK/HTTP timeouts and queue wait timeout, in seconds.
EXTERNAL_TIMEOUT_SECONDS=30
QUERY_LOCK_TIMEOUT_SECONDS=180
